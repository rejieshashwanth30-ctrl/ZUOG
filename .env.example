# ADYK ZUOG — Environment Variables Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.

# ==============================================================================
# Neon PostgreSQL Connection
# ==============================================================================
# Connection pooling URL for runtime queries (from Neon console connection string)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-dry-firefly-bdsq972j-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled URL for migrations and Prisma schema deployments
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-dry-firefly-bdsq972j.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Supabase Authentication
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ==============================================================================
# WhatsApp Business Notification Provider (Official Meta Cloud API)
# ==============================================================================
WHATSAPP_API_TOKEN="your-meta-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
WHATSAPP_API_VERSION="v21.0"

# ==============================================================================
# Email Notification Provider (Resend / SendGrid / SMTP)
# ==============================================================================
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="ADYK ZUOG Compliance <compliance@adykzuog.com>"

# ==============================================================================
# Background Scheduler & Cron Protection
# ==============================================================================
# Secret key used in Authorization: Bearer <CRON_SECRET> to trigger automated reminder runs
CRON_SECRET="your-secure-cron-secret-token"

# ==============================================================================
# AI Compliance Intelligence Provider
# ==============================================================================
# Supported: "gemini" | "openai" | "fallback" (deterministic rule-based engine)
AI_PROVIDER="gemini"
AI_API_KEY="your-gemini-or-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# ==============================================================================
# Application Configuration
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
